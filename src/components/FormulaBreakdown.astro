---
import type { Product } from '../data/types';
import { ingredientBySlug } from '../data/ingredients';

interface Props {
  product: Product;
  /** Heading level for the block title. */
  heading?: 'h2' | 'h3';
  title?: string;
  showSource?: boolean;
  id?: string;
}
const { product: p, heading = 'h2', title = 'Formula breakdown', showSource = true, id = `fb-${p.slug}` } = Astro.props;
const H = heading;

// Log scale, 0.01% to 100%: a 0.1% retinol and a 96% essence both stay readable.
const MIN = Math.log10(0.01);
const MAX = Math.log10(100);
/** Published strings stay as published ("1,000 ppm"); the bar converts to percent. */
const toPercent = (c: string) => {
  const v = parseFloat(c.replace(/,/g, ''));
  if (/ppb/i.test(c)) return v / 1e7;
  if (/ppm/i.test(c)) return v / 1e4;
  return v;
};
const pos = (c: string) => {
  const v = toPercent(c);
  if (!Number.isFinite(v) || v <= 0) return 0;
  return Math.max(0.02, Math.min(1, (Math.log10(v) - MIN) / (MAX - MIN)));
};
const rows = p.keyIngredients;
const published = rows.filter((r) => r.concentration).length;
const sourceHost = (() => {
  try {
    return new URL(p.source).hostname.replace(/^www\./, '');
  } catch {
    return p.source;
  }
})();
---

<section class="fb" aria-labelledby={`${id}-h`} data-bars>
  <div class="fb-head">
    <H id={`${id}-h`} class="fb-title">{title}</H>
    <p class="mono fb-sum">
      {rows.length} key ingredients · {published} published {published === 1 ? 'strength' : 'strengths'}
    </p>
  </div>
  <ul role="list" class="fb-rows">
    {
      rows.map((r, i) => {
        const ing = r.ingredient ? ingredientBySlug.get(r.ingredient) : undefined;
        return (
          <li class="fb-row">
            <details class="fb-d">
              <summary>
                <span class="fb-n mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="fb-name">
                  {r.name}
                  <span class="fb-role">{r.role}</span>
                </span>
                {r.concentration ? (
                  <span class="fb-val mono">{r.concentration}</span>
                ) : (
                  <span class="fb-val fb-val--np mono">Not published</span>
                )}
                <span class="fb-bar" aria-hidden="true">
                  {r.concentration ? (
                    <span class="fb-fill" style={`--v:${pos(r.concentration)}`} />
                  ) : (
                    <span class="fb-hatch" />
                  )}
                </span>
              </summary>
              <div class="fb-more">
                <p class="mono fb-inci">INCI: {r.inci}</p>
                {ing ? (
                  <>
                    <p>{ing.answer}</p>
                    <a class="link" href={`/ingredients/${ing.slug}`}>
                      {ing.name}: who it suits, when to use it
                    </a>
                  </>
                ) : (
                  <p>Supporting ingredient in this formula.</p>
                )}
                {!r.concentration && <p class="fb-np">The brand does not publish this strength, so we show none.</p>}
              </div>
            </details>
          </li>
        );
      })
    }
  </ul>
  <p class="fb-foot label">
    Where a brand publishes nothing, the row says so. We do not estimate. Bars use a log scale, 0.01% to 100%.{
      showSource && (
        <>
          {' '}
          Source: <a href={p.source} rel="noopener nofollow" target="_blank">{sourceHost}</a>.
        </>
      )
    }
  </p>
</section>

<style>
  .fb {
    border: 1px solid var(--ink);
    background: var(--paper);
  }
  .fb-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    padding: 14px 16px 10px;
    border-bottom: 1px solid var(--ink);
  }
  .fb-title {
    font-size: var(--fs-18);
    letter-spacing: -0.02em;
  }
  .fb-sum {
    font-size: var(--fs-12);
    color: var(--graphite);
  }
  .fb-rows {
    margin: 0;
  }
  .fb-row + .fb-row {
    border-top: 1px solid var(--hairline);
  }
  summary {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    grid-template-areas: 'n name val' 'n bar bar';
    gap: 6px 10px;
    align-items: center;
    padding: 12px 16px;
    cursor: pointer;
    list-style: none;
    min-height: var(--tap);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--bone);
  }
  .fb-n {
    grid-area: n;
    font-size: var(--fs-12);
    color: var(--graphite);
    align-self: start;
    padding-top: 2px;
  }
  .fb-name {
    grid-area: name;
    font-weight: 550;
    font-size: var(--fs-15);
    line-height: 1.25;
  }
  .fb-role {
    display: block;
    font-weight: 400;
    font-size: var(--fs-13);
    color: var(--graphite);
  }
  .fb-val {
    grid-area: val;
    font-size: var(--fs-15);
    font-weight: 600;
    text-align: right;
  }
  .fb-val--np {
    font-size: var(--fs-12);
    font-weight: 500;
    color: var(--graphite);
    border: 1px dashed var(--line-strong);
    padding: 2px 6px;
  }
  .fb-bar {
    grid-area: bar;
    position: relative;
    height: 8px;
    background:
      linear-gradient(to right, var(--hairline) 1px, transparent 1px) 0 0 / 25% 100%,
      var(--bone);
    border-right: 1px solid var(--hairline);
    overflow: hidden;
  }
  .fb-fill {
    position: absolute;
    inset: 0;
    background: var(--sage-deep);
    transform-origin: left;
    transform: scaleX(var(--v));
    transition: transform 900ms var(--ease);
  }
  :global(.js) [data-bars]:not(.is-in) .fb-fill {
    transform: scaleX(0);
  }
  .fb-hatch {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(-45deg, transparent 0 4px, var(--line-strong) 4px 5px);
    opacity: 0.55;
  }
  .fb-d[open] summary {
    background: var(--bone);
  }
  .fb-more {
    display: grid;
    gap: 8px;
    padding: 2px 16px 14px 54px;
    background: var(--bone);
    font-size: var(--fs-14);
  }
  .fb-inci {
    font-size: var(--fs-12);
    color: var(--graphite);
  }
  .fb-np {
    color: var(--graphite);
  }
  .fb-foot {
    padding: 10px 16px;
    border-top: 1px solid var(--hairline);
  }
  .fb-foot a {
    color: var(--ink);
  }
  @media (min-width: 640px) {
    summary {
      grid-template-columns: 28px minmax(0, 1.2fr) minmax(0, 1.4fr) 104px;
      grid-template-areas: 'n name bar val';
    }
  }
</style>
