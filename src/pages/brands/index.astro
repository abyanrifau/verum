---
import Base from '../../layouts/Base.astro';
import { brands, productsByBrand } from '../../lib/catalog';
import { itemListLd, breadcrumbLd } from '../../lib/seo';
import { mvr } from '../../lib/money';

const korean = brands.filter((b) => b.origin === 'Korean');
const western = brands.filter((b) => b.origin === 'Western');
const groups = [
  { id: 'korean', label: 'Korean brands', list: korean },
  { id: 'western', label: 'Western brands', list: western },
];
const range = (slug: string) => {
  const ps = productsByBrand(slug).map((p) => p.price);
  return ps.length > 1 ? `${mvr(Math.min(...ps))} to ${mvr(Math.max(...ps))}` : mvr(ps[0]);
};
---

<Base
  title="Brands we stock · Korean and Western · VERUM"
  description="21 Korean and Western skincare brands, all bought directly from the brand or its authorised distributor. Never grey market, no sponsored placements."
  ogImage="/og/brands.png"
  jsonld={[
    itemListLd('Brands at VERUM', brands.map((b) => ({ url: `/brands/${b.slug}`, name: b.name }))),
    breadcrumbLd([
      { name: 'Home', url: '/' },
      { name: 'Brands', url: '/brands' },
    ]),
  ]}
>
  <div class="wrap page-head">
    <p class="eyebrow">{brands.length} brands</p>
    <h1>Brands we stock</h1>
    <p class="lede">Every brand here is bought directly or through its authorised distributor. No brand pays to be listed or ranked.</p>
    <div class="page-head-actions">
      <a class="btn" href="/quiz">Find your routine in 30 seconds</a>
      <a class="btn btn--quiet" href="/shop">Shop all products</a>
    </div>
  </div>
  {
    groups.map((g) => (
      <section class="section" aria-labelledby={`bg-${g.id}`}>
        <div class="wrap">
          <h2 id={`bg-${g.id}`} class="bg-h">
            {g.label} <span class="mono muted">{g.list.length}</span>
          </h2>
          <ul role="list" class="blist">
            {g.list.map((b) => (
              <li>
                <a href={`/brands/${b.slug}`} class="bcard">
                  <span class="bcard-top mono">
                    {b.country}
                    {b.founded ? ` · since ${b.founded}` : ''}
                  </span>
                  <span class="bcard-name">{b.name}</span>
                  <span class="bcard-blurb">{b.blurb.split('. ')[0]}.</span>
                  <span class="bcard-meta mono">
                    {productsByBrand(b.slug).length} {productsByBrand(b.slug).length === 1 ? 'product' : 'products'} · {range(b.slug)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .bg-h {
    font-size: var(--fs-h3);
    margin-bottom: 16px;
  }
  .bg-h .mono {
    font-size: var(--fs-14);
    font-weight: 400;
  }
  .blist {
    display: grid;
    border-top: 1px solid var(--hairline);
    border-left: 1px solid var(--hairline);
  }
  .bcard {
    display: grid;
    gap: 6px;
    padding: 16px;
    background: var(--paper);
    text-decoration: none;
    height: 100%;
    align-content: start;
  }
  .bcard:hover {
    background: var(--bone);
  }
  .bcard-top {
    font-size: 11px;
    color: var(--graphite);
  }
  .bcard-name {
    font-size: var(--fs-20);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .bcard-blurb {
    font-size: var(--fs-14);
    color: var(--graphite);
  }
  .bcard-meta {
    font-size: var(--fs-12);
    color: var(--sage-deep);
    margin-top: 4px;
  }
  @media (min-width: 700px) {
    .blist {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1100px) {
    .blist {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
